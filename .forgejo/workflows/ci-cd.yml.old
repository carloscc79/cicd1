name: Pipeline CI/CD Demo - Desarrollo y Nuevas Tecnologías

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

env:
  REGISTRY: forgejo.tu-dominio.com
  IMAGE_NAME: ${{ github.repository }}

jobs:
  # ==========================================
  # FASE 1: INTEGRACIÓN CONTINUA (CI)
  # ==========================================
  code-quality-and-test:
    name: 1. Calidad de Código y Pruebas
    runs-on: docker
    steps:
      - name: Checkout del código
        uses: actions/checkout@v3

      - name: Configurar entorno Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Instalar dependencias de desarrollo
        run: |
          python -m pip install --upgrade pip
          pip install flake8 pytest
          if [ -f app/requirements.txt ]; then pip install -r app/requirements.txt; fi

      - name: Análisis estático de código (Linting)
        run: |
          # Fails si hay errores sintácticos o variables no definidas
          flake8 app/src --count --select=E9,F63,F7,F82 --show-source --statistics
          # Advertencias de estilo (no detienen el pipeline)
          flake8 app/src --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics

  security-scan:
    name: 2. Escaneo de Vulnerabilidades (SAST)
    runs-on: docker
    steps:
      - name: Checkout del código
        uses: actions/checkout@v3

      - name: Escaneo de vulnerabilidades en el código fuente con Trivy
        uses: https://github.com/aquasecurity/trivy-action@master
        with:
          scan-type: 'fs'
          scan-ref: './app'
          format: 'table'
          exit-code: '0' # Cambiar a '1' en producción para bloquear PRs con fallos críticos
          severity: 'HIGH,CRITICAL'

  build-and-push:
    name: 3. Construir y Publicar Imagen Docker
    needs: [code-quality-and-test, security-scan]
    runs-on: docker
    steps:
      - name: Checkout del código
        uses: actions/checkout@v3

      - name: Autenticación en Forgejo Container Registry
        uses: docker/login-action@v2
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.FORGEJO_TOKEN }}

      - name: Extraer Metadatos y Tags para Docker
        id: meta
        uses: docker/metadata-action@v4
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=sha,prefix=,format=short
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}

      - name: Compilar y Publicar Imagen Docker (Multi-stage)
        uses: docker/build-push-action@v4
        with:
          context: ./app
          file: ./app/Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}

  # ==========================================
  # FASE 2: DESPLIEGUE CONTINUO (CD)
  # ==========================================
  deploy-to-staging:
    name: 4. Despliegue con Ansible
    needs: [build-and-push]
    # Solo ejecuta el despliegue si los cambios fueron integrados a 'main'
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: docker
    steps:
      - name: Checkout del código
        uses: actions/checkout@v3

      - name: Configurar Llave SSH para Servidor Objetivo
        uses: webfactory/ssh-agent@v0.8.0
        with:
          ssh-private-key: ${{ secrets.SSH_PRIVATE_KEY }}

      - name: Ejecutar Playbook de Ansible (Despliegue Seguro)
        run: |
          # Se pasan credenciales e Image Tag dinámicamente
          ansible-playbook -i infra/ansible/inventory.ini infra/ansible/playbook.yml \
            --extra-vars "image_tag=${{ github.sha }} db_password=${{ secrets.DB_PASSWORD }} app_domain=${{ secrets.APP_DOMAIN }}"

  smoke-test:
    name: 5. Verificación POST-Despliegue (Smoke Test)
    needs: [deploy-to-staging]
    runs-on: docker
    steps:
      - name: Validar Endpoint de Salud (/health)
        run: |
          echo "Verificando disponibilidad del servicio..."
          # Reintentos durante 30s mientras levantan los contenedores
          for i in {1..6}; do
            HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://${{ secrets.APP_DOMAIN }}/health || true)
            if [ "$HTTP_STATUS" -eq 200 ]; then
              echo "✅ El servicio respondió HTTP 200 en /health. Despliegue Exitoso."
              exit 0
            fi
            echo "Intento $i: Servicio respondiendo HTTP $HTTP_STATUS. Esperando 5 segundos..."
            sleep 5
          done
          
          echo "ERROR: El servicio no respondió HTTP 200 a tiempo en /health."
          exit 1